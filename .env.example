# Copy to .env. Everything here is optional.

# PostgreSQL instead of the default local SQLite file (start it with: docker compose up -d)
# PROCUREAI_DATABASE_URL=postgresql+psycopg://procureai:procureai@localhost:5432/procureai

# Enables the Claude layer: extraction fallback for messy quotations + written summary
# ANTHROPIC_API_KEY=

# Cost-model assumptions
# PROCUREAI_BUYER_COUNTRY=United States
# PROCUREAI_COST_OF_CAPITAL=0.10
# PROCUREAI_IMPORT_DUTY_RATE=0.04
# PROCUREAI_DELAY_COST_RATE_PER_DAY=0.005
